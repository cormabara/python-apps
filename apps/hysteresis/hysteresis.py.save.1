# This is hysteresis simulation

import numpy as np

import matplotlib.pyplot as plot

from report import rpt_open, rpt_print_d, rpt_print

MAX_SPEED = 2000		# max range value
MIN_SPEED = 0			# min range value

MAX_EDGE = 1600 		# max edge
MIN_EDGE = 400 		# min edge

HIST_SHIFT = 1			# right shift to calculate hysteresis 

OUTPUT_LO = 0
OUTPUT_HI = 400



rpt_open()
rpt_print("CALCULATION OF HYSTERESIS \n")



def calculate_edges()
	# hysteresis is 1/8 of the useful interval
	hist = (int(((MAX_EDGE - MIN_EDGE)/2))>>HIST_SHIFT)
	rpt_print("hysteresis is (" + str(hist) + ")\n")

	min_edge_lo = MIN_EDGE - hist
	min_edge_hi = MIN_EDGE + hist
	rpt_print("min_edge_lo(" + str(min_edge_lo) + ") min_edge_hi(" + str(min_edge_hi) + ")")

	max_edge_lo = MAX_EDGE - hist
	max_edge_hi = MAX_EDGE + hist
	rpt_print("max_edge_lo(" + str(max_edge_lo) + ") max_edge_hi(" + str(max_edge_hi) + ")")


#Se uscita alta spegno se sono sopra max + hist e sotto min - hist
def calculate_out(speed_, outval_):

	if outval_ == OUTPUT_HI and ( (speed_ > max_edge_hi) or (speed_ < min_edge_lo) ):
		return OUTPUT_LO
	elif outval_ == OUTPUT_LO and ( (speed_ > min_edge_hi) and (speed_ < max_edge_lo) ):
		return OUTPUT_HI

	return outval_


time = np.arange(0, 1000, 1); # Get x values of the sine wave
speed   = MAX_SPEED/2 + (MAX_SPEED/2)*np.sin(time/100) # Amplitude of the sine wave is sine of a variable like time

speed_output = [OUTPUT_LO for i in time+1]

for index in time-1:
	speed_output[index+1] = calculate_out(speed[index+1], speed_output[index])
	rpt_print("speed is (" + str(speed[index]) + ")")
	rpt_print("output is (" + str(speed_output[index]) + ")")



plot.title('Sine wave') # Give a title for the sine wave plot
plot.xlabel('Time') # Give x axis label for the sine wave plot
plot.ylabel('speed = sin(time)') # Give y axis label for the sine wave plot
plot.grid(True, which='both')

plot.axhline(y=MAX_EDGE, color='k')
plot.axhline(y=MIN_EDGE, color='k')

plot.axhline(y=max_edge_hi, color='g', linestyle='dashed')
plot.axhline(y=max_edge_lo, color='g', linestyle='dashed')
plot.axhline(y=min_edge_hi, color='g', linestyle='dashed')
plot.axhline(y=min_edge_lo, color='g', linestyle='dashed')

plot.plot(time, speed,'y') # Plot a sine wave using time and amplitude obtained for the sine wave
plot.plot(time, speed_output,'r') # Plot a sine wave using time and amplitude obtained for the sine wave

plot.show()

